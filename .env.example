# Runtime
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:dev@localhost:55432/postgres   # Neon URLs are normalised
CORS_ORIGINS=http://localhost:3000  # comma-separated; * refused in production
ADMIN_TOKEN=                        # admin routes answer 503 while unset
METRICS_TOKEN=                      # /metrics answers 503 while unset

# Blobs
BLOB_STORE=local                    # local | r2
BLOB_ROOT=./var/blobs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PREFIX=inkthread/

# Models (OpenRouter :free only, DR-0003)
LLM_MODE=replay                     # live | replay | off
OPENROUTER_API_KEY=                 # required when LLM_MODE=live
OPENROUTER_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FAST=google/gemma-4-31b-it:free        # the verifier; must differ from PRIMARY
OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
LLM_MAX_REQUESTS_PER_DOCUMENT=8
LLM_DAILY_REQUEST_CAP=40
LLM_ACCOUNT_RESERVE=10

# Limits
MAX_UPLOAD_BYTES=15728640
MAX_PAGES=40
UPLOADS_PER_HOUR=5
RETENTION_DAYS=7
