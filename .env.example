# Runtime
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:dev@localhost:55432/postgres   # Neon URLs are normalised
CORS_ORIGINS=http://localhost:3000  # comma-separated; * refused in production
ADMIN_TOKEN=                        # admin routes answer 503 while unset
METRICS_TOKEN=                      # /metrics answers 503 while unset

# Platform token, contract v2 (spec 12). With no key, protected routes answer 503 outside APP_ENV=test.
BASTION_SIGNING_KEY_PUBLIC=         # base64 SPKI DER
BASTION_PUBLIC_KEY_URL=             # or fetch bastion's key (JSON field publicKey)
INKTHREAD_FRONTEND_SIGNING_KEY_PUBLIC=
DEMO_MODE=false                     # true lets a missing token through; never an invalid one

# Files: samples keep theirs; uploads are processed, not kept (spec 08 § 2)
BLOB_STORE=local                    # the samples' store: local | postgres | r2
BLOB_ROOT=./var/blobs
UPLOAD_ROOT=                        # uploads' transient files; defaults to <tmp>/inkthread-uploads
UPLOAD_TTL_MINUTES=60               # how long an upload's graph and page images stay
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PREFIX=inkthread/

# Models (OpenRouter :free only, DR-0003)
LLM_MODE=replay                     # live | replay | off
SAMPLE_LLM_MODE=replay              # samples run under the stricter of this and LLM_MODE
OPENROUTER_API_KEY=                 # required when LLM_MODE=live
OPENROUTER_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FAST=google/gemma-4-31b-it:free        # the verifier; must differ from PRIMARY
OPENROUTER_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
LLM_MAX_REQUESTS_PER_DOCUMENT=8
LLM_DAILY_REQUEST_CAP=40
LLM_ACCOUNT_RESERVE=10

# Limits
MAX_UPLOAD_BYTES=15728640
MAX_PAGES=40
UPLOADS_PER_HOUR=5
